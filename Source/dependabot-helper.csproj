<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Suppress warnings about missing source files -->
    <NoWarn>$(NoWarn);MSB4011</NoWarn>
  </PropertyGroup>

  <!-- Dynamically read all packages from Directory.Packages.props and create PackageReference items -->
  <Target Name="ReadPackagesFromDirectoryPackagesProps" BeforeTargets="CollectPackageReferences;Restore">
    <!-- Use XmlPeek to extract all PackageVersion items WITHOUT a Condition attribute -->
    <!-- This excludes platform-specific packages that would cause restore errors -->
    <XmlPeek
      XmlInputPath="$(MSBuildThisFileDirectory)Directory.Packages.props"
      Query="/Project/ItemGroup/PackageVersion[not(@Condition)]/@Include">
      <Output TaskParameter="Result" ItemName="_PackageIds" />
    </XmlPeek>

    <!-- Create PackageReference for each discovered package -->
    <ItemGroup>
      <PackageReference Include="@(_PackageIds)" />
    </ItemGroup>

    <Message Text="Dynamically added package: @(_PackageIds)" Importance="high" />
  </Target>
</Project>
