<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- nobody uses ARM Windows, so silencing the warning is harmless -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Gebhardt.Core.Application" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Application.Abstractions" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Application.Testing" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Architecture.Testing" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Domain" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.EntityFrameworkCore" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.EntityFrameworkCore.PostgreSql" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.EntityFrameworkCore.SqlServer" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Hosting" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Logging" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.MassTransit" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Testing" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.Testcontainers" Version="10.4.2" />
    <PackageVersion Include="Gebhardt.Core.WebApi" Version="10.4.2" />
    <!-- ====================================== -->
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <!-- VERSION LOCKED: Do not update (commercial license required) -->
    <PackageVersion Include="AutoMapper" Version="[14.0.0]" />
    <PackageVersion Include="AutoMapper.Extensions" Version="2.1.0" />
    <!-- ====================================== -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- Only update together, check which opentelemetry version corresponds to the Gebhart.Core.Observability packages -->
    <PackageVersion Include="Gebhardt.Core.Observability" Version="10.4.7" />
    <PackageVersion Include="Gebhardt.Core.Observability.Abstractions" Version="10.4.7" />
    <PackageVersion Include="OpenTelemetry.Resources.Container" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.17.0" />
    <!-- Only update together with notification center version in AgvDevComb -->
    <PackageVersion Include="Gebhardt.Core.NotificationCenter.Contracts" Version="[0.1.94]" />
    <!-- ====================================== -->
    <!-- Do not update to v9+ (commercial license required). Stay on v8.x (open source) -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.Abstractions" Version="8.5.10" />
    <PackageVersion Include="MassTransit.Prometheus" Version="8.1.3" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
    <PackageVersion Include="MassTransit.Quartz" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <!-- ====================================== -->
    <PackageVersion Include="System.IO.Hashing" Version="9.0.18" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="AppAny.Quartz.EntityFrameworkCore.Migrations.SqlServer" Version="0.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageVersion Include="Quartz.Extensions.DependencyInjection" Version="3.19.1" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.19.1" />
    <PackageVersion Include="Quartz.Plugins.TimeZoneConverter" Version="3.19.1" />
    <PackageVersion Include="Quartz" Version="3.19.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="KubernetesClient" Version="18.0.13" />
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="RestSharp" Version="113.1.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageVersion Include="SignalRSwaggerGen" Version="4.9.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.2" />
    <PackageVersion Include="MSTest" Version="4.3.2" />
    <PackageVersion Include="moq" Version="4.20.72" />
    <PackageVersion Include="tinyspline" Version="0.6.0.1" />
    <PackageVersion Include="ILogger.Moq" Version="2.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Vdma.Lif" Version="1.0.0.6" />
    <!-- Packages specific to Resharper scripts -->
    <PackageVersion Include="Sarif.Sdk" Version="4.6.0" />
    <!-- ====================================== -->
    <!-- Packages specific to IntegrationTest -->
    <PackageVersion Include="IdentityModel" Version="7.0.0" />
    <PackageVersion Include="NSwag.Annotations" Version="14.7.1" />
    <PackageVersion Include="NSwag.CodeGeneration.CSharp" Version="14.7.1" />
    <PackageVersion Include="NSwag.MSBuild" Version="14.7.1" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <!-- ====================================== -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="All" IncludeAssets="Build" />
  </ItemGroup>
</Project>