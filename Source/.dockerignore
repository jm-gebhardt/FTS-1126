# Specific project
**/Agv.IntegrationTest/
**/Agv.Karis/
**/Agv.Logimat/

# .NET specific exclusions
**/bin/
**/obj/
**/out/
**/publish/

# Log and temp files
**/*.log
**/*.user
**/*.suo
**/*.cache

# Git and version control
.git/
.gitignore
.gitattributes
.github/
.gitlab/

# AI Assistants
