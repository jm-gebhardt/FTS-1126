<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Gebhardt.Acc.IntegrationTest</AssemblyName>
        <Description></Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    <Import Project="..\..\Agv\SharedProjectSettings.csproj" />

    <PropertyGroup>
        <OpenApiConfigLocation>Api\transportorder.nswag</OpenApiConfigLocation>
        <GeneratedControllerFile>Api\transportorder_swagger.g.cs</GeneratedControllerFile>
    </PropertyGroup>
    <Target Name="GenerateApiControllerV1" BeforeTargets="CoreCompile" Outputs="$(MSBuildProjectFullPath).AlwaysRun">
        <Message Text="Generating C# controller code via NSwag" Importance="high" />
        <Exec Command="$(NSwagExe_Net100) run $(OpenApiConfigLocation) /variables:Configuration=$(Configuration)">
            <Output TaskParameter="ExitCode" PropertyName="NSwagExitCode" />
            <Output TaskParameter="ConsoleOutput" PropertyName="NSwagOutput" />
        </Exec>
    </Target>
    
    <ItemGroup>
      <PackageReference Include="Azure.Identity" />
      <PackageReference Include="IdentityModel" />
      <PackageReference Include="JetBrains.Annotations" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="NSwag.Annotations" />
      <PackageReference Include="NSwag.CodeGeneration.CSharp" />
      <PackageReference Include="NSwag.MSBuild">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="MQTTnet" />
      <PackageReference Include="MQTTnet.Extensions.ManagedClient" />
      <PackageReference Include="Polly" />
      <PackageReference Include="MSTest" />
      <PackageReference Include="Shouldly" />
    </ItemGroup>
</Project>
