<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Gebhardt.Acc.IntegrationTest</AssemblyName>
        <Description></Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    <Import Project="..\..\Agv\SharedProjectSettings.csproj" />

    <PropertyGroup>
        <OpenApiConfigLocation>Api\transportorder.nswag</OpenApiConfigLocation>
        <GeneratedControllerFile>Api\transportorder_swagger.g.cs</GeneratedControllerFile>
    </PropertyGroup>
    <Target Name="GenerateApiControllerV1" BeforeTargets="CoreCompile" Outputs="$(MSBuildProjectFullPath).AlwaysRun">
        <Message Text="Generating C# controller code via NSwag" Importance="high" />
        <Exec Command="$(NSwagExe_net80) run $(OpenApiConfigLocation) /variables:Configuration=$(Configuration)">
            <Output TaskParameter="ExitCode" PropertyName="NSwagExitCode" />
            <Output TaskParameter="ConsoleOutput" PropertyName="NSwagOutput" />
        </Exec>
    </Target>
    
    <ItemGroup>
      <PackageReference Include="Azure.Identity" Version="1.13.1" />
      <PackageReference Include="IdentityModel" Version="7.0.0" />
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.1" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.19" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.19" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
      <PackageReference Include="NSwag.Annotations" Version="14.6.0" />
      <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.6.0" />
      <PackageReference Include="NSwag.MSBuild" Version="14.6.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
      <PackageReference Include="MQTTnet.Extensions.ManagedClient" Version="4.3.7.1207" />
      <PackageReference Include="Polly" Version="8.6.3" />
      <PackageReference Include="MSTest" Version="3.10.3" />
      <PackageReference Include="Shouldly" Version="4.3.0" />
      <PackageReference Include="System.Formats.Asn1" Version="8.0.2" />
      <PackageReference Include="System.Text.Json" Version="8.0.6" />
    </ItemGroup>
</Project>
