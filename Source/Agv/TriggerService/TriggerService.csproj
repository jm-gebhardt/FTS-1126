<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Gebhardt.Acc.TriggerService</AssemblyName>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <Import Project="..\SharedProjectSettings.csproj" />
    <ItemGroup>
        <PackageReference Include="Gebhardt.Core.Hosting" />
        <PackageReference Include="Gebhardt.Core.WebApi" />
        <PackageReference Include="Gebhardt.Core.EntityFrameworkCore" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="MassTransit"  />
        <PackageReference Include="MassTransit.EntityFrameworkCore"  />
        <PackageReference Include="MassTransit.Prometheus" />
        <PackageReference Include="MassTransit.RabbitMQ"  />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" >
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"  />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj" />
        <ProjectReference Include="..\TriggerDefinition\Common.TriggerDefinition.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Migrations\" />
    </ItemGroup>
    <Target Name="DisableWarnings" BeforeTargets="CoreCompile">
        <ItemGroup>
            <AutoGeneratedFiles Include="**\Migrations\*.cs" />
            <AutoGeneratedFiles Include="**\Migrations\*\*.cs" />
        </ItemGroup>
        <WriteLinesToFile File="%(AutoGeneratedFiles.FullPath)" Condition="Exists(%(AutoGeneratedFiles.FullPath)) And !$([System.IO.File]::ReadAllText(%(AutoGeneratedFiles.FullPath)).StartsWith(&quot;#pragma warning&quot;))" Lines="$([System.String]::Concat(&quot;#pragma warning disable 1591, 0472&#xD;&#xA;&quot;,$([System.IO.File]::ReadAllText(%(AutoGeneratedFiles.FullPath))),&quot;#pragma warning restore 1591, 0472&quot;))" Overwrite="true" Encoding="Unicode" />
    </Target>
</Project>
