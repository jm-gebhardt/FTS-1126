<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Gebhardt.Acc.TriggerService</AssemblyName>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <Import Project="..\SharedProjectSettings.csproj" />
    <ItemGroup>
        <PackageReference Include="Gebhardt.Core.Hosting" />
        <PackageReference Include="Gebhardt.Core.WebApi" />
        <PackageReference Include="Gebhardt.Core.EntityFrameworkCore" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="MassTransit"  />
        <PackageReference Include="MassTransit.EntityFrameworkCore"  />
        <PackageReference Include="MassTransit.Prometheus" />
        <PackageReference Include="MassTransit.RabbitMQ"  />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" >
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"  />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj" />
        <ProjectReference Include="..\TriggerDefinition\Common.TriggerDefinition.csproj" />
        <ProjectReference Include="..\TriggerDecisionPoint1\TriggerDecisionPoint1.csproj" />
        <ProjectReference Include="..\TriggerCargoCheck\TriggerCargoCheck.csproj" />
        <ProjectReference Include="..\TriggerDoppelspiel\TriggerDoppelspiel.csproj" />
        <ProjectReference Include="..\TriggerQueueEvacuation\TriggerQueueEvacuation.csproj" />
        <ProjectReference Include="..\TriggerQueueHeadEvacuation\TriggerQueueHeadEvacuation.csproj" />
        <ProjectReference Include="..\TriggerEvacuateOrAssign\TriggerEvacuateOrAssign.csproj" />
        <ProjectReference Include="..\TriggerShortLoopWaitingPoint\TriggerShortLoopWaitingPoint.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Migrations\" />
    </ItemGroup>
    <Target Name="DisableWarnings" BeforeTargets="CoreCompile">
        <ItemGroup>
            <AutoGeneratedFiles Include="**\Migrations\*.cs" />
            <AutoGeneratedFiles Include="**\Migrations\*\*.cs" />
        </ItemGroup>
        <WriteLinesToFile File="%(AutoGeneratedFiles.FullPath)" Condition="Exists(%(AutoGeneratedFiles.FullPath)) And !$([System.IO.File]::ReadAllText(%(AutoGeneratedFiles.FullPath)).StartsWith(&quot;#pragma warning&quot;))" Lines="$([System.String]::Concat(&quot;#pragma warning disable 1591, 0472&#xD;&#xA;&quot;,$([System.IO.File]::ReadAllText(%(AutoGeneratedFiles.FullPath))),&quot;#pragma warning restore 1591, 0472&quot;))" Overwrite="true" Encoding="Unicode" />
    </Target>

    <Target Name="CopyTriggerPluginsToPublishDirectory" AfterTargets="Publish">
        <ItemGroup>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerDecisionPoint1.dll">
                <Folder>dp1</Folder>
            </TriggerPlugin>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerCargoCheck.dll">
                <Folder>dp2</Folder>
            </TriggerPlugin>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerDoppelspiel.dll">
                <Folder>dp3</Folder>
            </TriggerPlugin>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerQueueEvacuation.dll">
                <Folder>qe</Folder>
            </TriggerPlugin>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerQueueHeadEvacuation.dll">
                <Folder>qhe</Folder>
            </TriggerPlugin>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerEvacuateOrAssign.dll">
                <Folder>qhea</Folder>
            </TriggerPlugin>
            <TriggerPlugin Include="$(PublishDir)Gebhardt.Acc.TriggerShortLoopWaitingPoint.dll">
                <Folder>slw</Folder>
            </TriggerPlugin>
        </ItemGroup>

        <MakeDir Directories="@(TriggerPlugin->'$(PublishDir)triggers/%(Folder)')" />
        <Copy
            SourceFiles="@(TriggerPlugin)"
            DestinationFiles="@(TriggerPlugin->'$(PublishDir)triggers/%(Folder)/%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
    </Target>
</Project>
