{
  "openapi": "3.0.1",
  "info": {
    "title": "TransportOrder Monitoring API",
    "version": "v1"
  },
  "paths": {
    "/agvs": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve paged list of agvs",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agvs/{correlationId}/graph": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve graph for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvGraph"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvGraph"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvGraph"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/status": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve status for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/data": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve data for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "TransportOrder"
        ],
        "summary": "Retrieve active transport orders",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "description": "Page Number",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Page Size",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/meta/hubMethods": {
      "get": {
        "tags": [
          "Utility"
        ],
        "summary": "Get available SignalR hub methods",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agv": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "CorrelationId",
            "format": "uuid"
          },
          "agvId": {
            "type": "string",
            "description": "AGV Serial Number",
            "nullable": true
          },
          "currentState": {
            "type": "string",
            "description": "Current State",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Controller for host order data"
      },
      "AgvData": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "ipV4Address": {
            "type": "string",
            "nullable": true
          },
          "maxVelocityStraight": {
            "type": "number",
            "format": "double"
          },
          "batteryCapacity": {
            "type": "number",
            "format": "double"
          },
          "length": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "width": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "acceleration": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurn": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurnOnSpot": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "payload": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AgvGraph": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "relatedMapId": {
            "type": "string",
            "format": "uuid"
          },
          "relatedMapName": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "nullable": true
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AgvStatus": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "nullable": true
          },
          "busy": {
            "type": "boolean"
          },
          "automatic": {
            "type": "boolean"
          },
          "batteryCharge": {
            "type": "integer",
            "format": "int32"
          },
          "charging": {
            "type": "boolean"
          },
          "disturbed": {
            "type": "boolean"
          },
          "lastNodeId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Edge": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          },
          "metric": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "HostOrderCreator": {
        "enum": [
          "Wms",
          "Simulation"
        ],
        "type": "string"
      },
      "HubMethods": {
        "enum": [
          "OrderStateChanged",
          "AgvStateChanged"
        ],
        "type": "string",
        "description": "SignalR hub methods"
      },
      "Node": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/NodeType"
          },
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          },
          "z": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "NodeType": {
        "enum": [
          "Charge",
          "WayPoint",
          "Turn",
          "Station",
          "Park"
        ],
        "type": "string"
      },
      "Order": {
        "type": "object",
        "properties": {
          "currentState": {
            "type": "string",
            "nullable": true
          },
          "assignedAgv": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "orderDetails": {
            "$ref": "#/components/schemas/OrderDetails"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "description": "Order Model\r\n            \r\nThis is a simply copy of the Gebhardt.StoreWare.Agv.Common.Messages.AgvManagement.IOrder to overcome a json serialization problems\r\n<see href=\"https://github.com/dotnet/runtime/issues/41749\" />"
      },
      "OrderDetails": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "nullable": true
          },
          "destination": {
            "type": "string",
            "nullable": true
          },
          "leNo": {
            "type": "string",
            "nullable": true
          },
          "creator": {
            "$ref": "#/components/schemas/HostOrderCreator"
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "sensorIdentifier": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}