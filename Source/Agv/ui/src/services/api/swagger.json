{
  "openapi": "3.0.1",
  "info": {
    "title": "TransportOrder Monitoring API",
    "version": "v1"
  },
  "paths": {
    "/agvs": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve paged list of agvs",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agvs/{correlationId}/graph": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve graph for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              }
            }
          },
          "204": {
            "description": "No content"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/status": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve status for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/data": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve data for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvsPositions": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve list of agv positions",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgvPositionStatus"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgvPositionStatus"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgvPositionStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agvs/{correlationId}/setIdle": {
      "patch": {
        "tags": [
          "Agv"
        ],
        "summary": "Set status of agv from Discovered to Idle",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok: AGV status was successfully set to Idle"
          },
          "400": {
            "description": "Bad Request: AGV is not in State  Gebhardt.StoreWare.Agv.TransportOrder.Services.AgvStateMachine.Discovered"
          },
          "404": {
            "description": "Not Found: AGV with the given correlationId does not exist"
          }
        }
      }
    },
    "/maps": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Get all available maps",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/maps/{correlationId}/map.png": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Get Map Image",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/meta/hubMethods": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Get available SignalR hub methods",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "TransportOrder"
        ],
        "summary": "Retrieve active transport orders\r\nIf correlation Id is provided, all other parameters are ignored",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "description": "Page Number",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Page Size",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          },
          {
            "name": "Start",
            "in": "query",
            "description": "Start date of range",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "End",
            "in": "query",
            "description": "End date of range",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agv": {
        "required": [
          "agvId",
          "correlationId",
          "currentState"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "CorrelationId",
            "format": "uuid"
          },
          "agvId": {
            "type": "string",
            "description": "AGV Serial Number"
          },
          "currentState": {
            "type": "string",
            "description": "Current State"
          }
        },
        "additionalProperties": false,
        "description": "Controller for host order data"
      },
      "AgvData": {
        "required": [
          "batteryCapacity",
          "correlationId",
          "maxVelocityStraight",
          "model",
          "sensors",
          "type"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "ipV4Address": {
            "type": "string",
            "nullable": true
          },
          "maxVelocityStraight": {
            "type": "number",
            "format": "double"
          },
          "batteryCapacity": {
            "type": "number",
            "format": "double"
          },
          "length": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "width": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "acceleration": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurn": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurnOnSpot": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "payload": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            }
          }
        },
        "additionalProperties": false
      },
      "AgvPosition": {
        "required": [
          "positionInitialized",
          "theta",
          "x",
          "y",
          "z"
        ],
        "type": "object",
        "properties": {
          "positionInitialized": {
            "type": "boolean"
          },
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          },
          "z": {
            "type": "number",
            "format": "float"
          },
          "theta": {
            "type": "number",
            "format": "float"
          },
          "deviationRange": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AgvPositionStatus": {
        "required": [
          "agvId",
          "agvPosition",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "The correlationId of the new AGV position",
            "format": "uuid"
          },
          "agvId": {
            "type": "string",
            "description": "Identifier of the AGV"
          },
          "agvPosition": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgvPosition"
              }
            ],
            "description": "AGV position"
          }
        },
        "additionalProperties": false,
        "description": "Model for the status of the AGV position"
      },
      "AgvStatus": {
        "required": [
          "automatic",
          "batteryCharge",
          "busy",
          "charging",
          "correlationId",
          "disturbed"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "nullable": true
          },
          "busy": {
            "type": "boolean"
          },
          "automatic": {
            "type": "boolean"
          },
          "batteryCharge": {
            "type": "integer",
            "format": "int32"
          },
          "charging": {
            "type": "boolean"
          },
          "disturbed": {
            "type": "boolean"
          },
          "lastNodeId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Edge": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Node"
              }
            ],
            "description": "Node where the edge starts."
          },
          "to": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Node"
              }
            ],
            "description": "Node where the edge ends."
          }
        },
        "additionalProperties": false,
        "description": "Model for drawing an edge in the UI"
      },
      "Graph": {
        "required": [
          "correlationId",
          "edges",
          "nodes"
        ],
        "type": "object",
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "description": "The list of edges in the graph."
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "description": "The list of nodes in the graph"
          },
          "correlationId": {
            "type": "string",
            "description": "CorrelationId",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "description": "Model for drawing a graph in the UI"
      },
      "HostOrderCreator": {
        "enum": [
          "Wms",
          "Simulation"
        ],
        "type": "string"
      },
      "HubMethods": {
        "enum": [
          "OrderStateChanged",
          "AgvDiscovered",
          "AgvStateChanged",
          "AgvPositionChanged"
        ],
        "type": "string",
        "description": "SignalR hub methods"
      },
      "Map": {
        "required": [
          "correlationId",
          "mapId",
          "relatedAgvs",
          "resolution",
          "xOffset",
          "yOffset"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Map Correlation Id",
            "format": "uuid"
          },
          "mapId": {
            "type": "string",
            "description": "Map Id"
          },
          "resolution": {
            "type": "number",
            "description": "The resolution of the maps image. Expressed as how many [m] per pixel are represented",
            "format": "double"
          },
          "xOffset": {
            "type": "number",
            "description": "The x offset of the map in [m] where the mapped graph coordinate system starts. Origin is the left upper corner.",
            "format": "double"
          },
          "yOffset": {
            "type": "number",
            "description": "The y offset of the map in [m] where the mapped graph coordinate system starts. Origin is the left upper corner.",
            "format": "double"
          },
          "relatedAgvs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List of Agvs using this map"
          }
        },
        "additionalProperties": false,
        "description": "Map Model"
      },
      "Node": {
        "required": [
          "enabled",
          "id",
          "type",
          "x",
          "y",
          "z"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeType"
              }
            ]
          },
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          },
          "z": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "NodeType": {
        "enum": [
          "Charge",
          "WayPoint",
          "Turn",
          "Station",
          "Park"
        ],
        "type": "string"
      },
      "Order": {
        "required": [
          "correlationId",
          "currentState",
          "orderDetails"
        ],
        "type": "object",
        "properties": {
          "currentState": {
            "type": "string"
          },
          "assignedAgv": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "orderDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderDetails"
              }
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "failedReason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Order Model\r\n            \r\nThis is a simply copy of the Gebhardt.StoreWare.Agv.Common.Messages.AgvManagement.IOrder to overcome a json serialization problems\r\n<see href=\"https://github.com/dotnet/runtime/issues/41749\" />"
      },
      "OrderDetails": {
        "required": [
          "correlationId",
          "creationDate",
          "creator",
          "destination",
          "leNo",
          "orderId",
          "source"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "leNo": {
            "type": "string"
          },
          "creator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HostOrderCreator"
              }
            ]
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "sensorIdentifier": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}