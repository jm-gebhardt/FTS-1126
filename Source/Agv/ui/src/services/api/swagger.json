{
  "openapi": "3.0.1",
  "info": {
    "title": "TransportOrder Monitoring API",
    "version": "v1"
  },
  "paths": {
    "/agvs": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve paged list of agvs",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agvs/{correlationId}/graph": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve graph for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              }
            }
          },
          "204": {
            "description": "No content"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/data": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve data for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvsPositions": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve list of agv positions",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgvPositionStatus"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgvPositionStatus"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgvPositionStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agvs/{correlationId}/unlock": {
      "patch": {
        "tags": [
          "Agv"
        ],
        "summary": "Unlock AGV to allow it to be assigned to transport orders",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok: AGV status was successfully set to Idle"
          },
          "400": {
            "description": "Bad Request: AGV is not in State 'Discovered'"
          },
          "404": {
            "description": "Not Found: AGV with the given correlationId does not exist"
          }
        }
      }
    },
    "/agvs/{correlationId}/lock": {
      "patch": {
        "tags": [
          "Agv"
        ],
        "summary": "Lock AGV to prevent it from being assigned to transport orders",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok: AGV status was successfully unlocked"
          },
          "404": {
            "description": "Not Found: AGV with the given correlationId does not exist"
          }
        }
      }
    },
    "/agvs/{correlationId}/emitRequestData": {
      "patch": {
        "tags": [
          "Agv"
        ],
        "summary": "Emit RequestData telegram when receiving PATCH request",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok: Telegram was successfully emitted"
          },
          "404": {
            "description": "Not Found: AGV with the given correlationId does not exist"
          }
        }
      }
    },
    "/agvs/{correlationId}/emitRequestGraph": {
      "patch": {
        "tags": [
          "Agv"
        ],
        "summary": "Emit RequestGraph telegram when receiving PATCH request",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok: Telegram was successfully emitted"
          },
          "404": {
            "description": "Not Found: AGV with the given correlationId does not exist"
          }
        }
      }
    },
    "/maps": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Get all available maps",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/maps/{correlationId}/map.png": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Get Map Image",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/meta/hubMethods": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Get available SignalR hub methods",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agv": {
        "required": [
          "agvId",
          "badBatteryLevel",
          "batteryCharge",
          "correlationId",
          "currentState",
          "goodBatteryLevel",
          "isAutomatic",
          "isCharging",
          "isDisturbed",
          "isLocked",
          "isOnline",
          "timeOfLockStateChanged",
          "timeOfStateTransition"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "CorrelationId",
            "format": "uuid"
          },
          "agvId": {
            "type": "string",
            "description": "AGV Serial Number"
          },
          "currentState": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgvState"
              }
            ],
            "description": "Current State"
          },
          "timeOfStateTransition": {
            "type": "string",
            "description": "Time of the last state transition",
            "format": "date-time"
          },
          "timeOfLockStateChanged": {
            "type": "string",
            "description": "Time of the last lock state change",
            "format": "date-time"
          },
          "isOnline": {
            "type": "boolean",
            "description": "Communication alive state"
          },
          "isLocked": {
            "type": "boolean",
            "description": "Locked state"
          },
          "isDisturbed": {
            "type": "boolean",
            "description": "Is agv disturbed. There is at least one error with level \"FATAL\""
          },
          "isAutomatic": {
            "type": "boolean",
            "description": "AGV is in automatic mode"
          },
          "batteryCharge": {
            "type": "number",
            "description": "Battery charge level (Soc)",
            "format": "double"
          },
          "isCharging": {
            "type": "boolean",
            "description": "Is Battery currently charging"
          },
          "badBatteryLevel": {
            "type": "integer",
            "description": "Lower battery level in [%] for signaling \"battery bad\" (defined by VDA5050)",
            "format": "int32"
          },
          "goodBatteryLevel": {
            "type": "integer",
            "description": "Upper battery level in [%] for signaling \"battery good\" (defined by VDA5050)",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "AGV model"
      },
      "AgvData": {
        "required": [
          "batteryCapacity",
          "correlationId",
          "maxVelocityStraight",
          "model",
          "sensors",
          "type"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "The CorrelationId of the agv",
            "format": "uuid"
          },
          "model": {
            "type": "string",
            "description": "The model name of the AGV"
          },
          "type": {
            "type": "string",
            "description": "The type of the AGV"
          },
          "ipV4Address": {
            "type": "string",
            "description": "The IP Address of the AGV",
            "nullable": true
          },
          "batteryCapacity": {
            "type": "number",
            "description": "The capacity of the AGVs battery in [Ah]",
            "format": "double"
          },
          "acceleration": {
            "type": "number",
            "description": "The maximum velocity of the AGV while turning on spot [m/s^2]",
            "format": "double",
            "nullable": true
          },
          "maxVelocityStraight": {
            "type": "number",
            "description": "The maximum velocity of the AGV in straight direction [m/s]",
            "format": "double"
          },
          "maxVelocityTurn": {
            "type": "number",
            "description": "The maximum velocity of the AGV in while turning [m/s]",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurnOnSpot": {
            "type": "number",
            "description": "The maximum velocity of the AGV while turning on spot [rad/s]",
            "format": "double",
            "nullable": true
          },
          "width": {
            "type": "number",
            "description": "The width of the AGV in [m]",
            "format": "double",
            "nullable": true
          },
          "length": {
            "type": "number",
            "description": "The length of the AGV in [m]",
            "format": "double",
            "nullable": true
          },
          "payload": {
            "type": "integer",
            "description": "The max. payload of the AGV in [kg]",
            "format": "int64",
            "nullable": true
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            },
            "description": "The list of sensors in the agv"
          }
        },
        "additionalProperties": false,
        "description": "Agv Data model"
      },
      "AgvPosition": {
        "required": [
          "positionInitialized",
          "theta",
          "x",
          "y",
          "z"
        ],
        "type": "object",
        "properties": {
          "positionInitialized": {
            "type": "boolean",
            "description": "Returns true, when the position is known and valid."
          },
          "x": {
            "type": "number",
            "description": "Current X-position [m].",
            "format": "float"
          },
          "y": {
            "type": "number",
            "description": "Current Y-position [m].",
            "format": "float"
          },
          "z": {
            "type": "number",
            "description": "Current Z-position [m].",
            "format": "float"
          },
          "theta": {
            "type": "number",
            "description": "Current angle (rotation) [rad].",
            "format": "float"
          },
          "deviationRange": {
            "type": "number",
            "description": "Deviation from the responded position [m].",
            "format": "float",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "AGV position information"
      },
      "AgvPositionStatus": {
        "required": [
          "agvId",
          "agvPosition",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "The correlationId of the new AGV position",
            "format": "uuid"
          },
          "agvId": {
            "type": "string",
            "description": "Identifier of the AGV"
          },
          "agvPosition": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgvPosition"
              }
            ],
            "description": "AGV position information"
          }
        },
        "additionalProperties": false,
        "description": "Model for the status of the AGV position"
      },
      "AgvState": {
        "enum": [
          "Initial",
          "Discovered",
          "Idle",
          "Busy",
          "Charging"
        ],
        "type": "string",
        "description": "Agv State"
      },
      "Edge": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Node"
              }
            ],
            "description": "Node representation."
          },
          "to": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Node"
              }
            ],
            "description": "Node representation."
          }
        },
        "additionalProperties": false,
        "description": "Model for drawing an edge in the UI"
      },
      "Graph": {
        "required": [
          "correlationId",
          "edges",
          "nodes"
        ],
        "type": "object",
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "description": "The list of edges in the graph."
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "description": "The list of nodes in the graph"
          },
          "correlationId": {
            "type": "string",
            "description": "CorrelationId",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "description": "Model for drawing a graph in the UI"
      },
      "HubMethods": {
        "enum": [
          "AgvDiscovered",
          "AgvChanged",
          "AgvPositionChanged"
        ],
        "type": "string",
        "description": "SignalR hub methods"
      },
      "Map": {
        "required": [
          "correlationId",
          "mapId",
          "relatedAgvs",
          "resolution",
          "xOffset",
          "yOffset"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Map Correlation Id",
            "format": "uuid"
          },
          "mapId": {
            "type": "string",
            "description": "Map Id"
          },
          "resolution": {
            "type": "number",
            "description": "The resolution of the maps image. Expressed as how many [m] per pixel are represented",
            "format": "double"
          },
          "xOffset": {
            "type": "number",
            "description": "The x offset of the map in [m] where the mapped graph coordinate system starts. Origin is the left upper corner.",
            "format": "double"
          },
          "yOffset": {
            "type": "number",
            "description": "The y offset of the map in [m] where the mapped graph coordinate system starts. Origin is the left upper corner.",
            "format": "double"
          },
          "relatedAgvs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List of Agvs using this map"
          }
        },
        "additionalProperties": false,
        "description": "Map Model"
      },
      "Node": {
        "required": [
          "enabled",
          "id",
          "state",
          "theta",
          "type",
          "x",
          "y",
          "z"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique ID of the node."
          },
          "enabled": {
            "type": "boolean",
            "description": "Node enabled/disabled."
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeState"
              }
            ],
            "description": "Node state."
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeType"
              }
            ],
            "description": "Node type of the node."
          },
          "x": {
            "type": "number",
            "description": "The x coordinate of the node.",
            "format": "float"
          },
          "y": {
            "type": "number",
            "description": "The y coordinate of the node",
            "format": "float"
          },
          "z": {
            "type": "number",
            "description": "The z coordinate of the node.\r\n<br>\r\nSet to default 0 when not needed.\r\n",
            "format": "float"
          },
          "theta": {
            "type": "number",
            "description": "The theta coordinate of the node.",
            "format": "float"
          }
        },
        "additionalProperties": false,
        "description": "Node representation."
      },
      "NodeState": {
        "enum": [
          "Free",
          "Reserved",
          "Occupied",
          "Locked"
        ],
        "type": "string",
        "description": "Node state"
      },
      "NodeType": {
        "enum": [
          "WayPoint",
          "Charge",
          "Pick",
          "Drop",
          "PickDrop",
          "Park"
        ],
        "type": "string",
        "description": "Node types.\r\n<br>\r\nThese types are coming from the specification.\r\n"
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "sensorIdentifier": {
            "type": "string",
            "description": "The identifier of the sensor",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "A sensor object skeleton"
      }
    }
  },
  "tags": [
    {
      "name": "Agv",
      "description": "Controller for host order data"
    },
    {
      "name": "Map",
      "description": "Map Rest API Controller"
    },
    {
      "name": "Meta",
      "description": "Controller for meta data"
    }
  ]
}