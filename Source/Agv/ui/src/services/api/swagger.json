{
  "openapi": "3.0.1",
  "info": {
    "title": "TransportOrder Monitoring API",
    "version": "v1"
  },
  "paths": {
    "/agvs": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve paged list of agvs",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agv"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agvs/{correlationId}/graph": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve graph for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvGraph"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvGraph"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvGraph"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/status": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve status for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/agvs/{correlationId}/data": {
      "get": {
        "tags": [
          "Agv"
        ],
        "summary": "Retrieve data for agv",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgvData"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/maps": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Get all available maps",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Map"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/maps/{correlationId}/map.png": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Get Map Image",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/meta/hubMethods": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Get available SignalR hub methods",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubMethods"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "TransportOrder"
        ],
        "summary": "Retrieve active transport orders",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "description": "Page Number",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Page Size",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agv": {
        "required": [
          "agvId",
          "correlationId",
          "currentState"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "CorrelationId",
            "format": "uuid"
          },
          "agvId": {
            "type": "string",
            "description": "AGV Serial Number"
          },
          "currentState": {
            "type": "string",
            "description": "Current State"
          }
        },
        "additionalProperties": false,
        "description": "Controller for host order data"
      },
      "AgvData": {
        "required": [
          "batteryCapacity",
          "correlationId",
          "maxVelocityStraight",
          "model",
          "sensors",
          "type"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "ipV4Address": {
            "type": "string",
            "nullable": true
          },
          "maxVelocityStraight": {
            "type": "number",
            "format": "double"
          },
          "batteryCapacity": {
            "type": "number",
            "format": "double"
          },
          "length": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "width": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "acceleration": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurn": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxVelocityTurnOnSpot": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "payload": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            }
          }
        },
        "additionalProperties": false
      },
      "AgvGraph": {
        "required": [
          "correlationId",
          "edges",
          "nodes",
          "relatedMapId",
          "relatedMapName"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "relatedMapId": {
            "type": "string",
            "format": "uuid"
          },
          "relatedMapName": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Edge"
            }
          }
        },
        "additionalProperties": false
      },
      "AgvStatus": {
        "required": [
          "automatic",
          "batteryCharge",
          "busy",
          "charging",
          "correlationId",
          "disturbed"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "nullable": true
          },
          "busy": {
            "type": "boolean"
          },
          "automatic": {
            "type": "boolean"
          },
          "batteryCharge": {
            "type": "integer",
            "format": "int32"
          },
          "charging": {
            "type": "boolean"
          },
          "disturbed": {
            "type": "boolean"
          },
          "lastNodeId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Edge": {
        "required": [
          "from",
          "metric",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "metric": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "HostOrderCreator": {
        "enum": [
          "Wms",
          "Simulation"
        ],
        "type": "string"
      },
      "HubMethods": {
        "enum": [
          "OrderStateChanged",
          "AgvStateChanged",
          "AgvDiscovered"
        ],
        "type": "string",
        "description": "SignalR hub methods"
      },
      "Map": {
        "required": [
          "correlationId",
          "mapId",
          "relatedAgvs",
          "resolution",
          "xOffset",
          "yOffset"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "description": "Map Correlation Id",
            "format": "uuid"
          },
          "mapId": {
            "type": "string",
            "description": "Map Id"
          },
          "resolution": {
            "type": "number",
            "description": "The resolution of the maps image. Expressed as how many [m] per pixel are represented",
            "format": "double"
          },
          "relatedAgvs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List of Agvs using this map"
          },
          "xOffset": {
            "type": "number",
            "description": "The x offset of the map in [m] where the mapped graph coordinate system starts. . Origin is the left upper corner.",
            "format": "double"
          },
          "yOffset": {
            "type": "number",
            "description": "The y offset of the map in [m] where the mapped graph coordinate system starts. Origin is the left upper corner.",
            "format": "double"
          }
        },
        "additionalProperties": false,
        "description": "Map Model"
      },
      "Node": {
        "required": [
          "enabled",
          "id",
          "type",
          "x",
          "y",
          "z"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeType"
              }
            ]
          },
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          },
          "z": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      },
      "NodeType": {
        "enum": [
          "Charge",
          "WayPoint",
          "Turn",
          "Station",
          "Park"
        ],
        "type": "string"
      },
      "Order": {
        "required": [
          "correlationId",
          "currentState",
          "orderDetails"
        ],
        "type": "object",
        "properties": {
          "currentState": {
            "type": "string"
          },
          "assignedAgv": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "orderDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderDetails"
              }
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "description": "Order Model\r\n            \r\nThis is a simply copy of the Gebhardt.StoreWare.Agv.Common.Messages.AgvManagement.IOrder to overcome a json serialization problems\r\n<see href=\"https://github.com/dotnet/runtime/issues/41749\" />"
      },
      "OrderDetails": {
        "required": [
          "correlationId",
          "creationDate",
          "creator",
          "destination",
          "leNo",
          "orderId",
          "source"
        ],
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "leNo": {
            "type": "string"
          },
          "creator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HostOrderCreator"
              }
            ]
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "sensorIdentifier": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}