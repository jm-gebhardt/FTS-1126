{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:no-watch": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:check": "c8 check-coverage --lines 70",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue --ignore-path .gitignore --fix --max-warnings=0 src/",
    "lint:check": "eslint --ext .js,.ts,.vue --ignore-path .gitignore --max-warnings=0 src/",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate-api": "swagger-typescript-api -p ./src/services/api/swagger.json -o ./src/services/api --modular --type-prefix=I",
    "pr": "npm run format && npm run lint && npm run build && npm run coverage"
  },
  "dependencies": {
    "@microsoft/signalr": "^6.0.7",
    "@types/node": "^18.6.3",
    "balm-ui": "^10.11.0",
    "konva": "^8.3.12",
    "pinia": "^2.0.17",
    "sass": "^1.54.1",
    "vue": "^3.2.37",
    "vue-konva": "^3.0.1",
    "vue-router": "^4.1.3"
  },
  "devDependencies": {
    "@pinia/testing": "^0.0.14",
    "@typescript-eslint/eslint-plugin": "^5.32.0",
    "@typescript-eslint/parser": "^5.32.0",
    "@vitejs/plugin-vue": "^3.0.0",
    "@vitest/coverage-c8": "^0.22.1",
    "@vue/test-utils": "^2.0.2",
    "canvas": "^2.10.1",
    "eslint": "8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.3.0",
    "jsdom": "^20.0.0",
    "prettier": "^2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "swagger-typescript-api": "^10.0.2",
    "typescript": "~4.7.4",
    "vite": "^3.0.0",
    "vitest": "^0.22.1",
    "vue-eslint-parser": "^9.0.3",
    "vue-tsc": "^0.38.4"
  }
}
