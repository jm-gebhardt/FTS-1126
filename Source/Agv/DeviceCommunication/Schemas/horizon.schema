{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "horizon",
    "description": "New horizon for the agv to which it is allowed to travel.",
    "subtopic": "/horizon",
    "type": "object",
    "properties": {
        "SerialNumber": {
            "description": "Serial number of the agv.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "OrderId": {
            "type": "integer",
            "description": "The unique ID of the current order."
        },
        "Horizon": {
            "type": "array",
            "description": "The list of cleared points for the agv to pass",
            "items": {
                "type": "integer"
            }
        }
    },
    "required": [
        "SerialNumber",
        "OrderId",
        "Horizon"
    ]
}