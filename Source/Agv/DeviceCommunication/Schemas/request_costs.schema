{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "requestRoutingCosts",
    "description": "A routing cost request",
    "subtopic": "/requestRoutingCosts",
    "type": "object",
    "properties": {
        "SerialNumber": {
            "description": "Serial number of the AGV.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "RequestId": {
            "type": "string",
            "description": "A unique ID for that request."
        },
        "stations": {
            "type": "object",
            "properties": {
                "FromStationIdentifier": {
                    "type": "string",
                    "description": "The unique identifier of the station where to pick from",
                    "examples": [
                        "Source1",
                        "Source31"
                    ]
                },
                "ToStationIdentifier": {
                    "type": "string",
                    "description": "The unique identifier of the station where to drop",
                    "examples": [
                        "Destination2",
                        "Destination42"
                    ]
                }
            },
            "required": [
                "FromStationIdentifier",
                "ToStationIdentifier"
            ]
        },
        "coordinates": {
            "type": "object",
            "description": "The coordinates of the point where to go to",
            "properties": {
                "ToX": {
                    "type": "number"
                },
                "ToY": {
                    "type": "number"
                },
                "ToTheta": {
                    "type": "number"
                }
            },
            "required": [
                "ToX",
                "ToY",
                "ToTheta"
            ]
        }
    },
    "required": [
        "SerialNumber",
        "RequestId",
        "FromStationIdentifier",
        "ToStationIdentifier"
    ],
    "oneOf": [
        {
            "required": [
                "stations"
            ]
        },
        {
            "required": [
                "coordinates"
            ]
        }
    ]
}