{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "orderEvent",
    "description": "Order event of an ongoing order.",
    "subtopic": "/orderEvent",
    "type": "object",
    "properties": {
        "serialNumber": {
            "description": "The unique identifier of the agv.",
            "type": "string",
            "examples": [
                "AGV1",
                "AGV2"
            ]
        },
        "orderId": {
            "type": "string",
            "description": "The unique ID of the order."
        },
        "orderEventType": {
            "type": "string",
            "description": "The type of the order event (STARTED/COMPLETED/CANCELED/CANCELFAILED/UPDATED/UPDATEFAILED/FAILED).",
            "enum": [
                "STARTED",
                "COMPLETED",
                "CANCELED",
                "CANCELFAILED",
                "UPDATED",
                "UPDATEFAILED",
                "FAILED"
            ]
        }
    },
    "required": [
        "serialNumber",
        "orderId",
        "orderEventType"
    ]
}
