{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "map",
    "description": "Information about scale of the map and where to get it",
    "subtopic": "/map",
    "type": "object",
    "properties": {
        "SerialNumber": {
            "description": "Serial number of the AGV.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "ModificationDate": {
            "type": "string",
            "format": "date-time",
            "description": "The modification date of the map. Timestamp in ISO8601 format.",
            "examples": [
                "1991-03-11T11:40:03.12Z"
            ]
        },
        "RequestId": {
            "type": "string",
            "description": "The unique ID replied from the request."
        },
        "MapId": {
            "type": "string",
            "description": "The unique ID of the map",
            "examples": [
                "Area51_Floor1_Compartment47"
            ]
        },
        "Data": {
            "type": "string",
            "description": "The base 64 encoded data of the png image",
            "contentEncoding": "base64",
            "contentMediaType": "image/png"
        },
        "Resolution": {
            "type": "number",
            "description": "The resolution of the maps image. Expressed as how many [m] per pixel are represented",
            "examples": [
                0.01
            ]
        },
        "XOffset": {
            "type": "number",
            "description": "The x offset of the map in [m] (from the left upper corner) where the mapped graph coordinate system starts"
        },
        "YOffset": {
            "type": "number",
            "description": "The y offset of the map in [m] (from the left upper corner) where the mapped graph coordinate system starts"
        }
    },
    "required": [
        "SerialNumber",
        "ModificationDate",
        "RequestId",
        "URL",
        "Resolution",
        "XOffset",
        "YOffset"
    ]
}