{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "request_station_list",
    "description": "Requests the station list from the AGV",
    "subtopic": "/requestStationList",
    "type": "object",
    "properties": {
        "SerialNumber": {
            "description": "Serial number of the AGV.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "RequestId": {
            "type": "string",
            "description": "A unique ID for that request."
        }
    },
    "required": [
        "SerialNumber",
        "RequestId"
    ]
}