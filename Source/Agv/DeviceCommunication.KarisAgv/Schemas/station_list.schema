{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stationList",
  "description": "A list of all stations.",
  "subtopic": "/stationList",
  "type": "object",
  "properties": {
    "serialNumber": {
      "description": "Serial number of the agv.",
      "type": "string",
      "examples": [
        "1234-5678",
        "AGV2034"
      ]
    },
    "modificationDate": {
      "type": "string",
      "description": "The modification date of the graph. Timestamp in ISO8601 format.",
      "format": "date-time",
      "examples": [
        "1991-03-11T11:40:03.12Z"
      ]
    },
    "requestId": {
      "type": "string",
      "description": "The unique ID replied from the request."
    },
    "stations": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "function": {
              "type": "array",
              "description": "The function of the station: PICK/DROP/BOTH/CHARGE/PARK/MAINTENANCE. Multiple station types have to be sent as array, single can be sent as array or string.",
              "enum": [
                "PICK",
                "DROP",
                "BOTH",
                "CHARGE",
                "PARK",
                "MAINTENANCE"
              ]
            },
            "identifier": {
              "type": "string",
              "description": "The unique identifier of the station."
            },
            "position": {
              "type": "object",
              "description": "The position and rotation of the station based on to the maps/graphs coordinate system.",
              "properties": {
                "theta": {
                  "type": "number"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "theta",
                "x",
                "y"
              ]
            },
            "typeId": {
              "type": "string"
            }
          },
          "required": [
            "function",
            "identifier",
            "position",
            "typeId"
          ]
        }
      ]
    }
  },
  "required": [
    "serialNumber",
    "modificationDate",
    "requestId",
    "stations"
  ]
}
