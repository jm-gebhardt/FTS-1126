{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph",
  "description": "Graph representing the paths on which the agv travels.",
  "subtopic": "/graph",
  "type": "object",
  "properties": {
    "serialNumber": {
      "description": "Serial number of the agv.",
      "type": "string",
      "examples": [
        "1234-5678",
        "AGV2034"
      ]
    },
    "modificationDate": {
      "type": "string",
      "description": "The modification date of the graph. Timestamp in ISO8601 format.",
      "format": "date-time",
      "examples": [
        "1991-03-11T11:40:03.12Z"
      ]
    },
    "requestId": {
      "type": "string",
      "description": "The unique ID replied from the request."
    },
    "relatedMapId": {
      "type": "string",
      "description": "The unique ID of the map that belongs to the graph.",
      "examples": [
           "Area51_Floor1_Compartment47"
      ]
    },
    "nodes": {
      "type": "array",
      "description": "The list of nodes in the graph.",
      "items": [
        {
          "type": "object",
          "description": "The Node representation.",
          "properties": {
            "nodeId": {
              "type": "string",
              "description": "The unique ID of the node."
            },
            "x": {
              "type": "number",
              "description": "The x coordinate of the node."
            },
            "y": {
              "type": "number",
              "description": "The y coordinate of the node."
            },
            "z": {
              "type": "number",
              "description": "The z coordinate of the node. For example if there is a another floor. This field is not required."
            },
            "attributes": {
              "type": "array",
              "description": "The list of attributes attached to the node.",
              "items": [
                {
                  "type": "object",
                  "description": "The node attribute.",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "The key (name) of the attribute."
                    },
                    "value": {
                      "type": "string",
                      "description": "The value of the attribute."
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                }
              ]
            }
          },
          "required": [
            "nodeId",
            "x",
            "y"
          ]
        }
      ]
    },
    "edges": {
      "type": "array",
      "description": "The list of edges in the graph.",
      "items": [
        {
          "type": "object",
          "description": "The Edge representation.",
            "properties": {
                "edgeId": {
                    "type": "string",
                    "description": "The unique ID of the edge."
                },
                "startId": {
                    "type": "string",
                    "description": "The ID of the node where the edge starts."
                },
                "endId": {
                    "type": "string",
                    "description": "The ID of the node where the edge ends."
                },
                "bidirectional": {
                    "type": "boolean",
                    "description": "true/false. The edge can be traveled in both directions. If false, only from start to end is allowed.",
                    "examples": [
                        true,
                        false
                    ]
                },
                "maxVelocity": {
                    "type": "float",
                    "description": "The maximum allowed velocity on that edge [m/s]."
                },
                "edgeType": {
                    "type": "string",
                    "description": "The edge type (DIRECT/SLANTED/BEZIER2/BEZIER3/BEZIER5/POLYPATH).",
                    "enum": [
                        "DIRECT",
                        "SLANTED",
                        "BEZIER2",
                        "BEZIER3",
                        "BEZIER5",
                        "POLYPATH"
                    ]
                },
                "controlPoints": {
                    "type": "array",
                    "description": "The list of control points (absolute locations, w/o start end end of edge). BEZIER2 has one, BEZIER3 has two, BEZIER5 has four, and SLANTED at least one control points.",
                    "items": [
                        {
                            "type": "object",
                            "required": [
                                "x",
                                "y"
                            ],
                            "properties": {
                                "x": {
                                    "type": "number"
                                },
                                "y": {
                                    "type": "number"
                                }
                            }
                        }

                    ]
                },
                "exitAngle": {
                    "type": "number",
                    "description": "The exit angle of a curve of type 'SLANTED'."
                },
                "exitDistance": {
                    "type": "number",
                    "description": "The exit distance of a curve of type 'SLANTED'."
                },
                "attributes": {
                    "type": "array",
                    "description": "The list of attributes attached to the edge.",
                    "items": [
                        {
                            "type": "object",
                            "description": "Node attribute",
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "description": "The key (name) of the attribute."
                                },
                                "value": {
                                    "type": "string",
                                    "description": "The value of the attribute."
                                }
                            },
                            "required": [
                                "key",
                                "value"
                            ]
                        }
                    ]
                }
            },
          "required": [
            "edgeId",
            "startId",
            "endId",
            "bidirectional",
            "maxVelocity",
            "edgeType",
            "controlPoints"
          ]
        }
      ]
    }
  },
  "required": [
    "SerialNumber",
    "ModificationDate",
    "RequestId",
    "Nodes",
    "Edges"
  ]
}