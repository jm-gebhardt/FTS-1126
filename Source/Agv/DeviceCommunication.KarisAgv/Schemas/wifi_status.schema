{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "wifiStatus",
    "description": "Status regarding wifi of an AGV.",
    "subtopic": "/wifiStatus",
    "type": "object",
    "required": [
        "headerId",
        "timestamp",
		"version",
        "serialNumber",
        "ssid",
        "band",
        "channel",
        "frequency",
        "beaconSignalAverage",
        "quality",
        "noise"
    ],
    "properties": {
        "headerId": {
            "type": "integer",
            "description": "headerId of the message. The headerId is defined per topic and incremented by 1 with each sent (but not necessarily received) message."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp in ISO8601 format (YYYY-MM-DDTHH:mm:ss.ssZ).",
            "examples": [
                "1991-03-11T11:40:03.12Z"
            ]
        },
        "version": {
            "type": "string",
            "description": "Version of the protocol [Major].[Minor].[Patch].",
            "examples": [
                "1.3.2"
            ]
        },
        "serialNumber": {
            "type": "string",
            "description": "Serial number of the agv."
        },
        "ssid": {
            "type": "string",
            "description": "SSID string. OID \"status if wlan ssid\" (1.3.6.1.4.1.28097.7.2.1.2) found in ACKSYS-MIB file."
        },
        "band": {
            "type": "string",
            "description": "Wlan band/modulation type mix. OID \"status if wlan band\" (1.3.6.1.4.1.28097.7.2.1.4) found in ACKSYS-MIB file."
        },
        "channel": {
            "type": "string",
            "description": "Wlan channel (frequency span index): -1 channel indicates that the product is searching for a channel. OID \"status if wlan channel\" (1.3.6.1.4.1.28097.7.2.1.5) found in ACKSYS-MIB file."
        },
        "frequency": {
            "type": "string",
            "description": "Radio frequency: 0 frequency indicates that the product is searching for a radio frequency. OID \"status if wlan frequency\" (1.3.6.1.4.1.28097.7.2.1.6) found in ACKSYS-MIB file."
        },
        "beaconSignalAverage": {
            "type": "integer",
            "description": "Signal level average in dBm of the last few beacons received. This OID in WaveOS versions before 2.8.0.1 report the last beacon signal. OID \"status if wlan beacon signal avg\" (1.3.6.1.4.1.28097.7.2.1.16) found in ACKSYS-MIB file."
        },
        "quality": {
            "type": "integer",
            "description": "Radio link quality. OID \"status if wlan quality\" (1.3.6.1.4.1.28097.7.2.1.12) found in ACKSYS-MIB file."
        },
        "noise": {
            "type": "integer",
            "description": "Noise level in dBm. OID \"status if wlan noise\" (1.3.6.1.4.1.28097.7.2.1.17) found in ACKSYS-MIB file."
        }
    }
}