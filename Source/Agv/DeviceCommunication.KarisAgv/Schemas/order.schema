{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "order",
    "description": "New order for the agv.",
    "subtopic": "/order",
    "type": "object",
    "properties": {
        "serialNumber": {
            "description": "Serial number of the agv.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "orderId": {
            "type": "string",
            "description": "The unique ID of the order."
        },
        "orderType": {
            "type": "string",
            "description": "The type of the order (PICK/DROP/TRANSPORT/MOVE/CHARGE).",
            "enum": [
                "PICK",
                "DROP",
                "TRANSPORT",
                "MOVE",
                "CHARGE"
            ]
        },
        "recordType": {
            "type": "string",
            "description": "The type of the order (ORDER/ORDERUPDATE/ORDERCANCEL).",
            "enum": [
                "ORDER",
                "ORDERUPDATE",
                "ORDERCANCEL"
            ]
        },
        "stations": {
            "type": "object",
            "properties": {
                "fromStation": {
                    "type": "object",
                    "description": "The station where to pick from.",
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "The unique identifier of the station where to pick from.",
                            "examples": [
                                "Source1",
                                "Source31"
                            ]
                        },
                        "rotate": {
                            "type": "boolean",
                            "description": "Flag, if agv should rotate before accessing the station (to handle cargo which must be picked from back).",
                            "examples": [
                                true,
                                false
                            ]
                        },
                        "liftHeight": {
                            "type": "number",
                            "description": "The height where the cargo has to be picked [m]."
                        }
                    }
                },
                "toStation": {
                    "type": "object",
                    "description": "The station where to drop.",
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "The unique identifier of the station where to drop.",
                            "examples": [
                                "Destination2",
                                "Destination42"
                            ]
                        },
                        "rotate": {
                            "type": "boolean",
                            "description": "Flag, if agv should rotate before accessing the station.",
                            "examples": [
                                true,
                                false
                            ]
                        },
                        "liftHeight": {
                            "type": "number",
                            "description": "The height where the cargo has to be dropped [m]."
                        }
                    }
                },
                "oneOf": [
                    {
                        "required": [
                            "fromStationProperties"
                        ]
                    },
                    {
                        "required": [
                            "toStationProperties"
                        ]
                    }
                ]
            }
        },
        "coordinates": {
            "type": "object",
            "description": "The coordinates of the point where to go to.",
            "properties": {
                "toX": {
                    "type": "number"
                },
                "toY": {
                    "type": "number"
                },
                "toTheta": {
                    "type": "number"
                }
            },
            "required": [
                "toX",
                "toY",
                "toTheta"
            ]
        },
        "route": {
            "type": "object",
            "description": "The route to travel set by the master control expressed in nodes and edges.",
            "properties": {
                "nodes": {
                    "type": "array",
                    "items": {}
                },
                "edges": {
                    "type": "array",
                    "items": {}
                }
            },
            "required": [
                "nodes",
                "edges"
            ]
        }
    },
    "required": [
        "serialNumber",
        "orderId",
        "recordType",
        "orderType"
    ],
    "oneOf": [
        {
            "required": [
                "stations"
            ]
        },
        {
            "required": [
                "coordinates"
            ]
        }
    ]
}