{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "order",
    "description": "New order for the agv.",
    "subtopic": "/order",
    "type": "object",
    "properties": {
        "serialNumber": {
            "description": "Serial number of the agv.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "orderId": {
            "type": "string",
            "description": "The unique ID of the order."
        },
        "orderType": {
            "type": "string",
            "description": "The type of the order (PICK/DROP/TRANSPORT/MOVE/CHARGE).",
            "enum": [
                "PICK",
                "DROP",
                "TRANSPORT",
                "MOVE",
                "CHARGE"
            ]
        },
        "recordType": {
            "type": "string",
            "description": "The type of the order (ORDER/ORDERUPDATE/ORDERCANCEL).",
            "enum": [
                "ORDER",
                "ORDERUPDATE",
                "ORDERCANCEL"
            ]
        },
        "stations": {
            "type": "object",
            "properties": {
                "fromStationIdentifier": {
                    "type": "string",
                    "description": "The unique identifier of the station where to pick from.",
                    "examples": [
                        "Source1",
                        "Source31"
                    ]
                },
                "toStationIdentifier": {
                    "type": "string",
                    "description": "The unique identifier of the station where to drop.",
                    "examples": [
                        "Destination2",
                        "Destination42"
                    ]
                }
            },
            "oneOf": [
                {
                    "required": [
                        "fromStationIdentifier"
                    ]
                },
                {
                    "required": [
                        "toStationIdentifier"
                    ]
                }
            ]
        },
        "coordinates": {
            "type": "object",
            "description": "The coordinates of the point where to go to.",
            "properties": {
                "toX": {
                    "type": "number"
                },
                "toY": {
                    "type": "number"
                },
                "toTheta": {
                    "type": "number"
                }
            },
            "required": [
                "toX",
                "toY",
                "toTheta"
            ]
        },
        "route": {
            "type": "object",
            "description": "The route to travel set by the master control expressed in nodes and edges.",
            "properties": {
                "nodes": {
                    "type": "array",
                    "items": {}
                },
                "edges": {
                    "type": "array",
                    "items": {}
                }
            },
            "required": [
                "nodes",
                "edges"
            ]
        }
    },
    "required": [
        "serialNumber",
        "orderId",
        "recordType",
        "orderType"
    ],
    "oneOf": [
        {
            "required": [
                "stations"
            ]
        },
        {
            "required": [
                "coordinates"
            ]
        }
    ]
}