{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "requestAgvData",
    "description": "Requests the basic agv data from the agv.",
    "subtopic": "/requestAgvData",
    "type": "object",
    "properties": {
        "serialNumber": {
            "description": "Serial number of the agv.",
            "type": "string",
            "examples": [
                "1234-5678",
                "AGV2034"
            ]
        },
        "requestId": {
            "type": "string",
            "description": "A unique ID for that request."
        }
    },
    "required": [
        "serialNumber",
        "requestId"
    ]
}