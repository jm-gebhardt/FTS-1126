    <ItemGroup>
        <ProjectReference Include="..\Common.Testing\Common.Testing.csproj"/>
        <ProjectReference Include="..\SmartLinkCommunication\SmartLinkCommunication.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="TestData\SmartLinkResponse.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="TestData\module_config.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

