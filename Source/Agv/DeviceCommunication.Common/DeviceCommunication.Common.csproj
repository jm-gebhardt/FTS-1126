<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Gebhardt.Acc.DeviceCommunication.Common</AssemblyName>
        <OutputType>Library</OutputType>
    </PropertyGroup>
    <Import Project="..\SharedProjectsSettings.props" />
    <ItemGroup>
        <PackageReference Include="MassTransit" />
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="MassTransit.RabbitMQ" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Common\Common.csproj" />
    </ItemGroup>
 
    <ItemGroup>
        <None Update="Configuration\InstantActionConfiguration.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
