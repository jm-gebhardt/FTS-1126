<Project>
  <ItemGroup>
    <!--
      Suppress specific NuGet vulnerability warnings for packages that are not actually used in .NET 10:

      System.Net.Http 4.3.0 and System.Text.RegularExpressions 4.3.0 have known vulnerabilities but are
      transitive dependencies from MassTransit 8.5.5 (locked for licensing reasons). In .NET 10, these
      old packages are NOT loaded at runtime - the framework provides these APIs directly, making the
      vulnerabilities inapplicable.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7jgj-8wvc-jh57" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cmhx-cq75-c4mj" />

    <!--
      AutoMapper 14.0.0 has a DoS vulnerability (GHSA-rvv3-g6hj-g44x) via uncontrolled recursion on
      deeply nested object graphs. The fix requires v16.1.1+ which is commercially licensed.
      Risk is low: all mapped objects are internal system DTOs, not user-controlled input.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\artifacts\</ArtifactsPath>
  </PropertyGroup>
</Project>
