{
    admin off
    local_certs
    ocsp_stapling off
    auto_https off
}

(sub) {
    redir /{args.0} /{args.0}/
    handle_path /{args.0}/* {
        reverse_proxy {args.1}
    }
}

(sub_with_path) {
    redir /{args.0} /{args.0}/
    handle /{args.0}/* {
        reverse_proxy {args.1}
    }
}

*:80 {
    handle_errors {
        header Content-Type text/plain
        respond "{http.error.status_code} {http.error.status_text}"
    }
    
   log {
        output discard
   }

    import sub_with_path prometheus prometheus.agv:9090
    import sub grafana grafana.agv:3000
    import sub rabbitmq rabbitmq.agv:15672
    
    import sub_with_path cadvisor cadvisor.agv:8080
    
    import sub wcscommunication wcscommunication.agv
    import sub transportorder transportorder.agv
    import sub devicecommunication devicecommunication.agv
    
    ## AGV Control UI
    redir /ui /ui/
    handle_path /ui/* {
        root * /etc/caddy/html/ui
        try_files {path} /index.html
        file_server
    }
     
    handle / {
        root * /etc/caddy/html/index
        file_server
    }
}
